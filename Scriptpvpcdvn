--========================================================--
--                    HITBOX (SLIDER)
--========================================================--

local hitboxEnabled = false
local hitboxSize = 5

local HitboxBtn = Instance.new("TextButton", Main)
HitboxBtn.Size = UDim2.new(1, -20, 0, 40)
HitboxBtn.Position = UDim2.new(0, 10, 0, 100)
HitboxBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
HitboxBtn.TextColor3 = Color3.new(1,1,1)
HitboxBtn.Text = "hitbox người chơi : TẮT"
Instance.new("UICorner", HitboxBtn)

-- Slider
local Slider = Instance.new("TextLabel", Main)
Slider.Size = UDim2.new(1, -20, 0, 40)
Slider.Position = UDim2.new(0, 10, 0, 150)
Slider.BackgroundColor3 = Color3.fromRGB(50,50,50)
Slider.TextColor3 = Color3.new(1,1,1)
Slider.Text = "Hitbox Size: 5"
Instance.new("UICorner", Slider)

local SliderBar = Instance.new("TextButton", Slider)
SliderBar.Size = UDim2.new(0, 20, 1, 0)
SliderBar.Position = UDim2.new(0, 0, 0, 0)
SliderBar.BackgroundColor3 = Color3.fromRGB(255, 140, 0)
Instance.new("UICorner", SliderBar)

local dragging = false

SliderBar.MouseButton1Down:Connect(function()
	dragging = true
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

RunService.RenderStepped:Connect(function()
	if dragging then
		local mouse = UIS:GetMouseLocation().X
		local minX = Slider.AbsolutePosition.X
		local maxX = minX + Slider.AbsoluteSize.X

		local clamped = math.clamp(mouse, minX, maxX)
		local percent = (clamped - minX) / Slider.AbsoluteSize.X
		local value = math.floor(percent * 100)

		SliderBar.Position = UDim2.new(percent, 0, 0, 0)
		hitboxSize = value
		Slider.Text = "Hitbox Size: " .. value
	end
end)

HitboxBtn.MouseButton1Click:Connect(function()
	hitboxEnabled = not hitboxEnabled
	HitboxBtn.Text = "hitbox người chơi : " .. (hitboxEnabled and "BẬT" or "TẮT")
end)

-- Kéo hitbox cho người khác
RunService.RenderStepped:Connect(function()
	if hitboxEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
				plr.Character.HumanoidRootPart.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
				plr.Character.HumanoidRootPart.Transparency = 0.7
				plr.Character.HumanoidRootPart.Color = Color3.fromRGB(255,140,0)
				plr.Character.HumanoidRootPart.Material = Enum.Material.Neon
			end
		end
	end
end)

--========================================================--
--               HIỆN MÁU NGƯỜI GẦN
--========================================================--

local hpEnabled = true

local HPBtn = Instance.new("TextButton", Main)
HPBtn.Size = UDim2.new(1, -20, 0, 40)
HPBtn.Position = UDim2.new(0, 10, 0, 200)
HPBtn.BackgroundColor3 = Color3.fromRGB(60,60,60)
HPBtn.TextColor3 = Color3.new(1,1,1)
HPBtn.Text = "8hcari👍 : BẬT"
Instance.new("UICorner", HPBtn)

HPBtn.MouseButton1Click:Connect(function()
	hpEnabled = not hpEnabled
	HPBtn.Text = "8hcari👍 : " .. (hpEnabled and "BẬT" or "TẮT")
end)

RunService.RenderStepped:Connect(function()
	if hpEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("Head") then
				if not plr.Character.Head:FindFirstChild("BillboardGui") then
					local bb = Instance.new("BillboardGui", plr.Character.Head)
					bb.Size = UDim2.new(4,0,1,0)
					bb.AlwaysOnTop = true

					local bar = Instance.new("Frame", bb)
					bar.Size = UDim2.new(1,0,0.2,0)
					bar.Position = UDim2.new(0,0,0.8,0)
					bar.BackgroundColor3 = Color3.fromRGB(255,0,0)
					Instance.new("UICorner", bar)

					bar.Name = "HPBar"
				end

				local hp = plr.Character:FindFirstChild("Humanoid").Health
				local max = plr.Character:FindFirstChild("Humanoid").MaxHealth
				local bar = plr.Character.Head.BillboardGui:FindFirstChild("HPBar")

				bar.Size = UDim2.new(hp/max, 0, 0.2, 0)
			end
		end
	end
end)

